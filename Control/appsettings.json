{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": ""
  },
  "Cache": {
    "InstanceName": "KvmControl",
    "OperationRetentionHours": 168,
    "VncTicketLifetimeMinutes": 5
  },
  "Operations": {
    "QueueCapacity": 64,
    "WorkerCount": 4,
    "ExecutionTimeoutMinutes": 30
  },
  "ClusterMetrics": {
    "PollIntervalSeconds": 15,
    "MaxConcurrentPolls": 4,
    "OfflineAfterMissedPolls": 3
  },
  "Clusters": {
    "Nodes": {
      "local": {
        "Address": "https://localhost:7226",
        "AllowSelfSignedCertificate": false
      }
    }
  }
}
